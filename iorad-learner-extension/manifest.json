{
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "name": "iorad Learner",
  "version": "1.0.0",
  "description": "iorad learner - for learners only accessing (not capturing) iorad tutorials.",
  "icons": {
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "author": "iorad",
  "short_name": "iorad learner",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "match_about_blank": false,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [{
    "resources": ["page.js"],
    "matches": [
      "<all_urls>"
    ]
  }],
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "remove-csp",
        "enabled": true,
        "path": "rule_remove_csp.json"
      }
    ]
  }
}
