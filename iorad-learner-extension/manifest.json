{
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "name": "iorad Learner",
  "version": "1.0.0",
  "description": "iorad learner - for employees only accessing (not capturing) iorad tutorials.",
  "icons": {
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "author": "iorad",
  "short_name": "iorad learner",
  "content_scripts": [
    {
      "matches": [
        "https://salesforce.com/**",
        "https://*.salesforce.com/**",
        "https://workday.com/**",
        "https://*.workday.com/**"
      ],
      "match_about_blank": false,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "https://salesforce.com/*",
    "https://*.salesforce.com/*",
    "https://workday.com/*",
    "https://*.workday.com/*"
  ],
  "web_accessible_resources": [{
    "resources": ["page.js"],
    "matches": [
      "https://salesforce.com/*",
      "https://*.salesforce.com/*",
      "https://workday.com/*",
      "https://*.workday.com/*"
    ]
  }]
}
